{
  "name": "playwrightframework",
  "version": "1.0.0",
  "description": "Enterprise Playwright UI + API automation framework",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test src/tests/smoke",
    "test:api": "playwright test src/tests/api",
    "report": "playwright show-report",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report"
  },
  "keywords": [
    "playwright",
    "typescript",
    "automation",
    "testing",
    "api-testing",
    "ui-testing"
  ],
  "author": "Arun Kumar",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.6.2",
    "eslint": "^10.3.0",
    "prettier": "^3.8.3"
  },
  "dependencies": {
    "allure-playwright": "^3.7.2",
    "axios": "^1.16.0",
    "dotenv": "^17.4.2",
    "faker": "^6.6.6",
    "winston": "^3.19.0"
  }
}